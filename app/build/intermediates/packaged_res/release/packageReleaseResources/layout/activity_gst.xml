<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GST Calculator"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etGstAmount"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Amount"
        android:inputType="numberDecimal"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary"
        android:backgroundTint="@color/cyan"/>

    <EditText
        android:id="@+id/etGstRate"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="GST Rate %"
        android:inputType="numberDecimal"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary"
        android:backgroundTint="@color/cyan"/>

    <Button
        android:id="@+id/btnCalculateGst"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="15dp"
        android:text="Calculate GST"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvGstResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Enter values and calculate"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="20dp"
        android:background="@color/card_background"/>

</LinearLayout>
